# Locked Claude Code environment for the phase-0 pilot.
# Source this only after exporting HARNESS_BODY_DIR and HARNESS_MITM_CA.
# The runner does that itself. Do not point either path at ~/.claude.
#
# Verification of each variable is in docs/docs-verification.md (2026-10-29).
# Variables whose behavior the docs do not confirm are absent, not guessed.

export DISABLE_AUTOUPDATER=1
export CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1
export CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION=false
export CLAUDE_CODE_DISABLE_FAST_MODE=1
export CLAUDE_CODE_DISABLE_REFUSAL_FALLBACK=1
export CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK=1
export CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
export CLAUDE_CODE_DISABLE_CLAUDE_MDS=1
export CLAUDE_CODE_EFFORT_LEVEL=low
export CLAUDE_CODE_MAX_RETRIES=3
export DISABLE_AUTO_COMPACT=1
export CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=1
export CLAUDE_CODE_DISABLE_AGENT_VIEW=1
export CLAUDE_CODE_GZIP_REQUEST_BODIES=0
export CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT=1

export CLAUDE_CODE_ENABLE_TELEMETRY=1
export CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1
export OTEL_TRACES_EXPORTER=otlp
export OTEL_LOGS_EXPORTER=otlp
export OTEL_METRICS_EXPORTER=none
export OTEL_EXPORTER_OTLP_PROTOCOL=http/json
export OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
export OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
export OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://127.0.0.1:4318/v1/logs
export OTEL_LOG_RAW_API_BODIES=file:${HARNESS_BODY_DIR}

export HTTPS_PROXY=http://127.0.0.1:8080
export HTTP_PROXY=http://127.0.0.1:8080
export NO_PROXY=127.0.0.1,localhost
export NODE_EXTRA_CA_CERTS=${HARNESS_MITM_CA}

# Not set, on purpose:
# CLAUDE_CODE_SIMPLE / --bare     drops OAuth; calibration must stay inside claude -p
# ANTHROPIC_API_KEY               console key; the runner refuses to start if one is set
# ENABLE_BETA_TRACING_DETAILED    retargets export; query_source is read from api_request logs
# CLAUDE_CODE_RETRY_WATCHDOG      would retry 429/529 without the cap of 3
# CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS
# FORCE_PROMPT_CACHING_5M         phase-0 observes the subscription default; do not force 5m
# CLAUDE_CODE_PROMPT_CACHE_TTL    left unset so the ttl_json cell can read the effective TTL
# CLAUDE_CODE_MAX_OUTPUT_TOKENS   set by the runner only for the max_output cell
# DISABLE_PROMPT_CACHING          set by the runner only for the system_prompt cell
